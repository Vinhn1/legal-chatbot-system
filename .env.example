# Mẫu cấu hình Legal Chatbot System. Sao chép thành .env trên máy vận hành và điền bí mật riêng.
# Không commit .env hoặc dùng các giá trị giả lập làm thông tin xác thực thật.

# PostgreSQL: DB_HOST=db khi chạy Compose, đổi thành 127.0.0.1 khi chạy Backend local.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=legal_user
DB_PASSWORD=
DB_DATABASE=legal_db
# Chỉ đặt true một lần trên PostgreSQL mới để tạo bảng; sau đó chuyển về false.
DB_SYNCHRONIZE=false

# Xác thực quản trị; mật khẩu seed chỉ áp dụng khi chưa có tài khoản admin.
JWT_SECRET=
JWT_EXPIRES_IN=1d
ADMIN_SEED_PASSWORD=

# AI Core và Backend phải dùng cùng token nội bộ; không công bố cổng AI Core trong Compose.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
AI_CORE_INTERNAL_TOKEN=
# Chỉ có tác dụng khi mô hình Cross-Encoder đã có sẵn tại đường dẫn trong container.
LEGAL_RERANKER_MODEL_PATH=
# Khi chạy Backend local, đặt AI_SERVICE_BASE_URL=http://127.0.0.1:8001.
AI_SERVICE_BASE_URL=http://127.0.0.1:8001
AI_SERVICE_TIMEOUT_MS=60000

# Thư điện tử dùng cho OTP; chỉ cấu hình khi sử dụng luồng gửi email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Nguồn trình duyệt được Backend cho phép; cập nhật nếu đổi cổng Frontend.
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:8080
# Frontend dùng đường dẫn tương đối để proxy /api ở Vite hoặc Nginx.
VITE_API_URL=/api

# Khóa mã hóa riêng cho khóa provider lưu ở server; điền ngoài Git, tối thiểu 32 ký tự.
LLM_KEY_ENCRYPTION_SECRET=
