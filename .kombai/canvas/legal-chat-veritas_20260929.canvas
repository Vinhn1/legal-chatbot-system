        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css');\n.font-ui{font-family:'DM Sans',sans-serif}.font-editorial{font-family:'Newsreader',serif}.board-scroll{scrollbar-width:thin;scrollbar-color:#bcc5d1 transparent}\n</style>\n<div class=\"font-ui min-h-screen bg-[#e9edf2] text-[#17243a] antialiased\" data-kid=\"1\">\n    <main class=\"mx-auto max-w-[1440px] px-5 py-8 md:px-9 lg:px-12\" data-kid=\"1-1\">\n        <header class=\"mb-7 flex flex-col gap-5 border-b border-[#ccd4de] pb-6 md:flex-row md:items-end md:justify-between\" data-kid=\"1-1-1\">\n            <div data-kid=\"1-1-1-1\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.24em] text-[#59708b]\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"h-px w-7 bg-[#a17842]\" data-kid=\"1-1-1-1-1-1\">\n                    </span>\n                    Veritas Legal Design · 03\n                </div>\n                <h1 class=\"font-editorial mt-2 text-4xl font-semibold leading-none tracking-[-.035em] text-[#112444] md:text-5xl\" data-kid=\"1-1-1-1-2\">\n                    Một nguồn. Từ tiếp nhận đến đối chiếu.\n                </h1>\n                <p class=\"mt-3 max-w-3xl text-sm leading-6 text-[#56677c]\" data-kid=\"1-1-1-1-3\">\n                    Phương án hệ thống giao diện cho chatbot RAG pháp luật Việt Nam — thiết kế quanh khả năng lần lại nguồn, không quanh một dashboard chung chung.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-2 text-[10px] font-semibold\" data-kid=\"1-1-1-2\">\n                <span class=\"rounded-full border border-[#d9c9ad] bg-[#faf7f0] px-3 py-1.5 text-[#785c32]\" data-kid=\"1-1-1-2-1\">\n                    UI prototype · Dữ liệu minh họa\n                </span>\n                <span class=\"rounded-full border border-[#cbd5df] bg-white px-3 py-1.5 text-[#516278]\" data-kid=\"1-1-1-2-2\">\n                    1440 / 768 / 390\n                </span>\n                <span class=\"rounded-full border border-[#cbd5df] bg-white px-3 py-1.5 text-[#516278]\" data-kid=\"1-1-1-2-3\">\n                    Light + dark\n                </span>\n            </div>\n        </header>\n        <section class=\"mb-8 rounded-2xl border border-[#d3dbe4] bg-[#f8f8f6] p-5 md:p-6\" data-kid=\"1-1-2\">\n            <div class=\"mb-4 flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.18em] text-[#68788b]\" data-kid=\"1-1-2-1\">\n                <i class=\"ti ti-route text-sm text-[#a17842]\" data-kid=\"1-1-2-1-1\">\n                </i>\n                Hai hướng đã cân nhắc · Hướng được chọn\n            </div>\n            <div class=\"grid gap-3 lg:grid-cols-[1fr_1fr_1.2fr]\" data-kid=\"1-1-2-2\">\n                <article class=\"rounded-xl border border-[#e0e4e9] bg-white/70 p-4\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[.14em] text-[#78889a]\" data-kid=\"1-1-2-2-1-1\">\n                        01 · Veritas Editorial\n                    </div>\n                    <h2 class=\"font-editorial mt-1 text-xl font-semibold text-[#1a2e4d]\" data-kid=\"1-1-2-2-1-2\">\n                        Văn bản là giao diện\n                    </h2>\n                    <p class=\"mt-1 text-xs leading-5 text-[#68788b]\" data-kid=\"1-1-2-2-1-3\">\n                        Bố cục biên tập, khoảng trắng và phân cấp chữ làm nổi bật chứng cứ.\n                        <b class=\"text-[#53667e]\" data-kid=\"1-1-2-2-1-3-1\">\n                            Mạnh:\n                        </b>\n                        dễ đọc, đáng tin từ landing đến phòng tra cứu.\n                    </p>\n                </article>\n                <article class=\"rounded-xl border border-[#e0e4e9] bg-white/70 p-4\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"text-[10px] font-bold uppercase tracking-[.14em] text-[#78889a]\" data-kid=\"1-1-2-2-2-1\">\n                        02 · Evidence Workbench\n                    </div>\n                    <h2 class=\"font-editorial mt-1 text-xl font-semibold text-[#1a2e4d]\" data-kid=\"1-1-2-2-2-2\">\n                        Ngoại lệ cần xử lý\n                    </h2>\n                    <p class=\"mt-1 text-xs leading-5 text-[#68788b]\" data-kid=\"1-1-2-2-2-3\">\n                        Bảng tác nghiệp nén, ưu tiên hàng đợi và trạng thái.\n                        <b class=\"text-[#53667e]\" data-kid=\"1-1-2-2-2-3-1\">\n                            Mạnh:\n                        </b>\n                        phát hiện nhanh OCR, metadata và hiệu lực.\n                    </p>\n                </article>\n                <article class=\"relative overflow-hidden rounded-xl border border-[#1d3558] bg-[#142747] p-4 text-white shadow-sm\" data-kid=\"1-1-2-2-3\">\n                    <div class=\"absolute right-0 top-0 h-full w-1 bg-[#c29a5b]\" data-kid=\"1-1-2-2-3-1\">\n                    </div>\n                    <div class=\"text-[10px] font-bold uppercase tracking-[.14em] text-[#b9c8db]\" data-kid=\"1-1-2-2-3-2\">\n                        03 · Được chọn · Sợi chỉ vòng đời nguồn\n                    </div>\n                    <h2 class=\"font-editorial mt-1 text-xl font-semibold text-white\" data-kid=\"1-1-2-2-3-3\">\n                        Từ văn bản đến câu trả lời\n                    </h2>\n                    <p class=\"mt-1 max-w-2xl text-xs leading-5 text-[#d4deea]\" data-kid=\"1-1-2-2-3-4\">\n                        Giữ nguyên nhãn nguồn, phiên bản và trạng thái qua nạp → lập chỉ mục → trích dẫn → rà soát. Đậm chất pháp lý nhưng vẫn thao tác nhanh.\n                    </p>\n                </article>\n            </div>\n            <p class=\"mt-3 text-[10px] leading-4 text-[#738196]\" data-kid=\"1-1-2-3\">\n                Tham chiếu chỉ để học nhịp điệu nội dung và cách tổ chức vận hành; không sao chép giao diện, mã nguồn, logo hay hình ảnh.\n                <span class=\"font-semibold text-[#8d6736]\" data-kid=\"1-1-2-3-1\">\n                    t06-summary-1280.png: ảnh tham chiếu chưa khả dụng.\n                </span>\n            </p>\n        </section>\n        <div class=\"mb-3 flex items-center justify-between\" data-kid=\"1-1-3\">\n            <h2 class=\"font-editorial text-3xl font-semibold text-[#142948]\" data-kid=\"1-1-3-1\">\n                01 · Hành trình công khai\n            </h2>\n            <span class=\"text-[10px] font-semibold uppercase tracking-[.16em] text-[#6c7c90]\" data-kid=\"1-1-3-2\">\n                Public · Editorial + source preview\n            </span>\n        </div>\n        <section class=\"mb-9 overflow-hidden rounded-2xl border border-[#ccd4dd] bg-[#faf9f6] shadow-[0_16px_50px_-32px_rgba(15,30,54,.38)]\" data-kid=\"1-1-4\">\n            <div class=\"flex items-center justify-between border-b border-[#e2e3df] px-6 py-3\" data-kid=\"1-1-4-1\">\n                <div class=\"flex items-center gap-2 text-[10px] font-bold uppercase tracking-[.15em] text-[#6a7b8e]\" data-kid=\"1-1-4-1-1\">\n                    <i class=\"ti ti-world text-sm\" data-kid=\"1-1-4-1-1-1\">\n                    </i>\n                    MÀN HÌNH · LANDING · 1440\n                </div>\n                <span class=\"rounded-full bg-[#f4eddf] px-2.5 py-1 text-[9px] font-bold text-[#80643c]\" data-kid=\"1-1-4-1-2\">\n                    Dữ liệu minh họa\n                </span>\n            </div>\n            <nav class=\"flex items-center justify-between px-8 py-4\" data-kid=\"1-1-4-2\">\n                <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-4-2-1\">\n                    <div class=\"grid h-9 w-9 place-items-center rounded-xl bg-[#182d4f] text-[#f6efe2]\" data-kid=\"1-1-4-2-1-1\">\n                        <i class=\"ti ti-scale text-lg\" data-kid=\"1-1-4-2-1-1-1\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-1-4-2-1-2\">\n                        <div class=\"text-sm font-bold tracking-tight text-[#172b4a]\" data-kid=\"1-1-4-2-1-2-1\">\n                            Veritas\n                            <span class=\"font-medium text-[#65758a]\" data-kid=\"1-1-4-2-1-2-1-1\">\n                                Legal\n                            </span>\n                        </div>\n                        <div class=\"text-[9px] uppercase tracking-[.16em] text-[#8b795f]\" data-kid=\"1-1-4-2-1-2-2\">\n                            Tra cứu có đối chiếu\n                        </div>\n                    </div>\n                </div>\n                <div class=\"hidden items-center gap-7 text-[11px] font-medium text-[#5c6c80] md:flex\" data-kid=\"1-1-4-2-2\">\n                    <span data-kid=\"1-1-4-2-2-1\">\n                        Khám phá\n                    </span>\n                    <span data-kid=\"1-1-4-2-2-2\">\n                        Cách hoạt động\n                    </span>\n                    <span data-kid=\"1-1-4-2-2-3\">\n                        Minh bạch dữ liệu\n                    </span>\n                </div>\n                <button class=\"rounded-lg border border-[#cbd3dd] bg-white px-4 py-2 text-[11px] font-semibold text-[#1c3457]\" data-kid=\"1-1-4-2-3\">\n                    Đăng nhập\n                </button>\n            </nav>\n            <div class=\"grid items-center gap-8 px-7 pb-9 pt-5 lg:grid-cols-[.9fr_1.1fr] lg:px-12 lg:pb-12\" data-kid=\"1-1-4-3\">\n                <div class=\"max-w-xl\" data-kid=\"1-1-4-3-1\">\n                    <div class=\"inline-flex items-center gap-2 rounded-full border border-[#dfd4c0] bg-[#f6f0e5] px-3 py-1.5 text-[9px] font-bold uppercase tracking-[.15em] text-[#795e37]\" data-kid=\"1-1-4-3-1-1\">\n                        <span class=\"h-1.5 w-1.5 rounded-full bg-[#b48b50]\" data-kid=\"1-1-4-3-1-1-1\">\n                        </span>\n                        Cổng tra cứu văn bản pháp luật Việt Nam\n                    </div>\n                    <h3 class=\"font-editorial mt-5 text-5xl font-semibold leading-[.99] tracking-[-.04em] text-[#142948]\" data-kid=\"1-1-4-3-1-2\">\n                        Tìm quy định.\n                        <br data-kid=\"1-1-4-3-1-2-1\"/>\n                        <span class=\"text-[#3568a1]\" data-kid=\"1-1-4-3-1-2-2\">\n                            Lần theo nguồn.\n                        </span>\n                    </h3>\n                    <p class=\"mt-4 max-w-md text-sm leading-6 text-[#56667b]\" data-kid=\"1-1-4-3-1-3\">\n                        Đặt câu hỏi tự nhiên, xem nhận định gắn với nguồn truy xuất và tự đối chiếu đoạn văn bản trước khi áp dụng.\n                    </p>\n                    <div class=\"mt-6 flex flex-wrap gap-3\" data-kid=\"1-1-4-3-1-4\">\n                        <button class=\"rounded-lg bg-[#1d4f88] px-5 py-3 text-[11px] font-bold text-white shadow-sm\" data-kid=\"1-1-4-3-1-4-1\">\n                            Khám phá sản phẩm\n                            <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-1-4-3-1-4-1-1\">\n                            </i>\n                        </button>\n                        <button class=\"rounded-lg border border-[#bdc8d5] bg-white px-5 py-3 text-[11px] font-semibold text-[#203b60]\" data-kid=\"1-1-4-3-1-4-2\">\n                            Đăng nhập\n                        </button>\n                    </div>\n                    <div class=\"mt-5 flex flex-wrap gap-x-5 gap-y-2 text-[10px] font-medium text-[#647388]\" data-kid=\"1-1-4-3-1-5\">\n                        <span data-kid=\"1-1-4-3-1-5-1\">\n                            <i class=\"ti ti-check text-[#2f7560]\" data-kid=\"1-1-4-3-1-5-1-1\">\n                            </i>\n                            Trích dẫn có thể mở\n                        </span>\n                        <span data-kid=\"1-1-4-3-1-5-2\">\n                            <i class=\"ti ti-check text-[#2f7560]\" data-kid=\"1-1-4-3-1-5-2-1\">\n                            </i>\n                            Hiệu lực được ghi trạng thái\n                        </span>\n                    </div>\n                    <p class=\"mt-5 max-w-md border-l-2 border-[#c49d5e] pl-3 text-[10px] leading-4 text-[#778497]\" data-kid=\"1-1-4-3-1-6\">\n                        Công cụ hỗ trợ tra cứu, không thay thế tư vấn pháp lý. Luôn kiểm tra văn bản gốc và phạm vi áp dụng.\n                    </p>\n                </div>\n                <div class=\"relative rounded-[1.35rem] border border-[#d9dfe4] bg-white p-3 shadow-[0_22px_55px_-30px_rgba(21,42,70,.28)] md:p-4\" data-kid=\"1-1-4-3-2\">\n                    <div class=\"mb-3 flex items-center justify-between border-b border-[#e7e9eb] pb-3\" data-kid=\"1-1-4-3-2-1\">\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-4-3-2-1-1\">\n                            <svg aria-label=\"Robot Legal AI\" data-kid=\"1-1-4-3-2-1-1-1\" height=\"34\" viewbox=\"0 0 120 120\" width=\"34\">\n                                <circle cx=\"60\" cy=\"60\" fill=\"#2c68ad\" r=\"39\">\n                                </circle>\n                                <path d=\"M24 59a36 36 0 0 1 72 0\" fill=\"none\" stroke=\"#142747\" stroke-linecap=\"round\" stroke-width=\"6\">\n                                </path>\n                                <rect fill=\"#142747\" height=\"21\" rx=\"4\" width=\"10\" x=\"13\" y=\"49\">\n                                </rect>\n                                <rect fill=\"#142747\" height=\"21\" rx=\"4\" width=\"10\" x=\"97\" y=\"49\">\n                                </rect>\n                                <path d=\"M38 64q22-12 44 0v10q-22 16-44 0z\" fill=\"#101d32\">\n                                </path>\n                                <circle cx=\"47\" cy=\"70\" fill=\"#56c2e9\" r=\"5\">\n                                </circle>\n                                <circle cx=\"73\" cy=\"70\" fill=\"#56c2e9\" r=\"5\">\n                                </circle>\n                                <text fill=\"#f7d790\" font-size=\"6\" font-weight=\"700\" text-anchor=\"middle\" x=\"60\" y=\"48\">\n                                    ⚖ LEGAL AI\n                                </text>\n                            </svg>\n                            <div data-kid=\"1-1-4-3-2-1-1-2\">\n                                <div class=\"text-[11px] font-bold text-[#213754]\" data-kid=\"1-1-4-3-2-1-1-2-1\">\n                                    Mẫu đối chiếu nguồn\n                                </div>\n                                <div class=\"text-[9px] text-[#7a8897]\" data-kid=\"1-1-4-3-2-1-1-2-2\">\n                                    Phần minh họa, không phải kết quả thật\n                                </div>\n                            </div>\n                        </div>\n                        <span class=\"rounded-full border border-[#e7d6b7] bg-[#fbf5e9] px-2 py-1 text-[8px] font-bold text-[#806137]\" data-kid=\"1-1-4-3-2-1-2\">\n                            NGUỒN MẪU\n                        </span>\n                    </div>\n                    <div class=\"grid gap-3 md:grid-cols-[1fr_.8fr]\" data-kid=\"1-1-4-3-2-2\">\n                        <div data-kid=\"1-1-4-3-2-2-1\">\n                            <div class=\"rounded-lg bg-[#f2f4f6] p-3\" data-kid=\"1-1-4-3-2-2-1-1\">\n                                <div class=\"text-[8px] font-bold uppercase tracking-[.12em] text-[#7c8a9b]\" data-kid=\"1-1-4-3-2-2-1-1-1\">\n                                    Câu hỏi\n                                </div>\n                                <div class=\"mt-1.5 text-[10px] leading-4 text-[#263a56]\" data-kid=\"1-1-4-3-2-2-1-1-2\">\n                                    Tôi muốn kiểm tra một quy định trong kho tài liệu này.\n                                </div>\n                            </div>\n                            <div class=\"mt-2 rounded-lg border border-[#e0e6ec] p-3\" data-kid=\"1-1-4-3-2-2-1-2\">\n                                <div class=\"flex items-center gap-2 text-[9px] font-bold text-[#25486e]\" data-kid=\"1-1-4-3-2-2-1-2-1\">\n                                    <i class=\"ti ti-sparkles\" data-kid=\"1-1-4-3-2-2-1-2-1-1\">\n                                    </i>\n                                    Trả lời có thể đối chiếu\n                                </div>\n                                <p class=\"mt-1.5 text-[10px] leading-5 text-[#45576e]\" data-kid=\"1-1-4-3-2-2-1-2-2\">\n                                    Bản trình diễn cho thấy vị trí của nhận định và nguồn truy xuất. Nội dung pháp lý thật chỉ xuất hiện khi được trả về từ kho đã cấu hình.\n                                </p>\n                                <button class=\"mt-2 rounded-md border border-[#c9d8e9] bg-[#f2f7fc] px-2.5 py-1.5 text-[8px] font-semibold text-[#244c7a]\" data-kid=\"1-1-4-3-2-2-1-2-3\">\n                                    Nguồn minh họa · Chưa xác minh\n                                </button>\n                                <div class=\"mt-2 flex items-center gap-1.5 text-[8px] text-[#758498]\" data-kid=\"1-1-4-3-2-2-1-2-4\">\n                                    <i class=\"ti ti-arrow-narrow-right\" data-kid=\"1-1-4-3-2-2-1-2-4-1\">\n                                    </i>\n                                    Chọn nguồn để mở đoạn gốc\n                                </div>\n                            </div>\n                        </div>\n                        <aside class=\"rounded-lg border border-[#e5ddce] bg-[#faf8f2] p-3\" data-kid=\"1-1-4-3-2-2-2\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-1-4-3-2-2-2-1\">\n                                <div class=\"text-[8px] font-bold uppercase tracking-[.12em] text-[#876a3f]\" data-kid=\"1-1-4-3-2-2-2-1-1\">\n                                    Đoạn nguồn\n                                </div>\n                                <i class=\"ti ti-x text-xs text-[#8490a0]\" data-kid=\"1-1-4-3-2-2-2-1-2\">\n                                </i>\n                            </div>\n                            <div class=\"mt-2 border-l-2 border-[#d4a95f] bg-[#fff3d8] px-2 py-2 text-[9px] leading-[1.8] text-[#475365]\" data-kid=\"1-1-4-3-2-2-2-2\">\n                                Đoạn văn bản được truy xuất sẽ hiển thị tại đây để người đọc tự kiểm tra ngữ cảnh.\n                            </div>\n                            <div class=\"mt-2 flex flex-wrap gap-1\" data-kid=\"1-1-4-3-2-2-2-3\">\n                                <span class=\"rounded bg-white px-1.5 py-1 text-[7px] text-[#68798d]\" data-kid=\"1-1-4-3-2-2-2-3-1\">\n                                    Chương được trích xuất\n                                </span>\n                                <span class=\"rounded bg-white px-1.5 py-1 text-[7px] text-[#68798d]\" data-kid=\"1-1-4-3-2-2-2-3-2\">\n                                    Điều / Khoản mẫu\n                                </span>\n                            </div>\n                            <div class=\"mt-2 rounded-md border border-[#e4d3b3] bg-[#f8f0df] px-2 py-1.5 text-[8px] font-semibold text-[#80643d]\" data-kid=\"1-1-4-3-2-2-2-4\">\n                                Chưa xác minh hiệu lực\n                            </div>\n                        </aside>\n                    </div>\n                    <div class=\"mt-3 flex items-center justify-between border-t border-[#ecebe7] pt-2 text-[8px] text-[#8390a0]\" data-kid=\"1-1-4-3-2-3\">\n                        <span data-kid=\"1-1-4-3-2-3-1\">\n                            <i class=\"ti ti-shield-check mr-1 text-[#507e68]\" data-kid=\"1-1-4-3-2-3-1-1\">\n                            </i>\n                            Nguồn thật hiển thị theo quyền truy cập\n                        </span>\n                        <span data-kid=\"1-1-4-3-2-3-2\">\n                            Dữ liệu minh họa\n                        </span>\n                    </div>\n                </div>\n            </div>\n            <div class=\"grid border-t border-[#e4e5e1] bg-white md:grid-cols-3\" data-kid=\"1-1-4-4\">\n                <div class=\"border-b border-[#e4e5e1] px-7 py-5 md:border-b-0 md:border-r lg:px-10\" data-kid=\"1-1-4-4-1\">\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.15em] text-[#8a785d]\" data-kid=\"1-1-4-4-1-1\">\n                        01 · Chuẩn hóa\n                    </div>\n                    <div class=\"font-editorial mt-1 text-xl font-semibold text-[#263e5f]\" data-kid=\"1-1-4-4-1-2\">\n                        Nạp & tách cấu trúc\n                    </div>\n                    <p class=\"mt-1 text-[10px] leading-4 text-[#6d7b8e]\" data-kid=\"1-1-4-4-1-3\">\n                        PDF, DOCX, URL hoặc văn bản; nhận diện cấu trúc để con người duyệt.\n                    </p>\n                </div>\n                <div class=\"border-b border-[#e4e5e1] px-7 py-5 md:border-b-0 md:border-r lg:px-10\" data-kid=\"1-1-4-4-2\">\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.15em] text-[#8a785d]\" data-kid=\"1-1-4-4-2-1\">\n                        02 · Truy xuất\n                    </div>\n                    <div class=\"font-editorial mt-1 text-xl font-semibold text-[#263e5f]\" data-kid=\"1-1-4-4-2-2\">\n                        Tìm theo ý nghĩa\n                    </div>\n                    <p class=\"mt-1 text-[10px] leading-4 text-[#6d7b8e]\" data-kid=\"1-1-4-4-2-3\">\n                        Đối chiếu câu hỏi với nội dung đã được phép đưa vào chỉ mục.\n                    </p>\n                </div>\n                <div class=\"px-7 py-5 lg:px-10\" data-kid=\"1-1-4-4-3\">\n                    <div class=\"text-[9px] font-bold uppercase tracking-[.15em] text-[#8a785d]\" data-kid=\"1-1-4-4-3-1\">\n                        03 · Kiểm chứng\n                    </div>\n                    <div class=\"font-editorial mt-1 text-xl font-semibold text-[#263e5f]\" data-kid=\"1-1-4-4-3-2\">\n                        Mở đúng đoạn nguồn\n                    </div>\n                    <p class=\"mt-1 text-[10px] leading-4 text-[#6d7b8e]\" data-kid=\"1-1-4-4-3-3\">\n                        Kiểm tra hiệu lực, phiên bản và ngữ cảnh trước khi sử dụng câu trả lời.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <div class=\"grid gap-6 xl:grid-cols-[1.25fr_.75fr]\" data-kid=\"1-1-5\">\n            <section class=\"rounded-2xl border border-[#ccd4dd] bg-[#faf9f6] p-6 shadow-[0_14px_42px_-34px_rgba(15,30,54,.38)]\" data-kid=\"1-1-5-1\">\n                <div class=\"flex items-end justify-between\" data-kid=\"1-1-5-1-1\">\n                    <div data-kid=\"1-1-5-1-1-1\">\n                        <div class=\"text-[9px] font-bold uppercase tracking-[.17em] text-[#8a785d]\" data-kid=\"1-1-5-1-1-1-1\">\n                            HOW IT WORKS · 4 CHẶNG\n                        </div>\n                        <h3 class=\"font-editorial mt-1 text-3xl font-semibold text-[#172e4f]\" data-kid=\"1-1-5-1-1-1-2\">\n                            Đường đi của một nguồn\n                        </h3>\n                    </div>\n                    <span class=\"hidden text-[9px] text-[#8390a0] sm:block\" data-kid=\"1-1-5-1-1-2\">\n                        Nạp → Lập chỉ mục → Hỏi → Đối chiếu\n                    </span>\n                </div>\n                <div class=\"mt-5 grid gap-2 sm:grid-cols-4\" data-kid=\"1-1-5-1-2\">\n                    <div class=\"rounded-xl border border-[#dee2e5] bg-white p-4\" data-kid=\"1-1-5-1-2-1\">\n                        <div class=\"text-[9px] font-bold text-[#ac8951]\" data-kid=\"1-1-5-1-2-1-1\">\n                            01\n                        </div>\n                        <div class=\"mt-2 text-[11px] font-bold text-[#203958]\" data-kid=\"1-1-5-1-2-1-2\">\n                            Tiếp nhận\n                        </div>\n                        <p class=\"mt-1 text-[9px] leading-4 text-[#778497]\" data-kid=\"1-1-5-1-2-1-3\">\n                            Tệp, URL hoặc text; xác nhận nguồn và phạm vi.\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-[#dee2e5] bg-white p-4\" data-kid=\"1-1-5-1-2-2\">\n                        <div class=\"text-[9px] font-bold text-[#ac8951]\" data-kid=\"1-1-5-1-2-2-1\">\n                            02\n                        </div>\n                        <div class=\"mt-2 text-[11px] font-bold text-[#203958]\" data-kid=\"1-1-5-1-2-2-2\">\n                            Lập chỉ mục\n                        </div>\n                        <p class=\"mt-1 text-[9px] leading-4 text-[#778497]\" data-kid=\"1-1-5-1-2-2-3\">\n                            Trích xuất, tách cấu trúc và duyệt trước khi dùng.\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-[#dee2e5] bg-white p-4\" data-kid=\"1-1-5-1-2-3\">\n                        <div class=\"text-[9px] font-bold text-[#ac8951]\" data-kid=\"1-1-5-1-2-3-1\">\n                            03\n                        </div>\n                        <div class=\"mt-2 text-[11px] font-bold text-[#203958]\" data-kid=\"1-1-5-1-2-3-2\">\n                            Đặt câu hỏi\n                        </div>\n                        <p class=\"mt-1 text-[9px] leading-4 text-[#778497]\" data-kid=\"1-1-5-1-2-3-3\">\n                            Truy xuất nội dung trong phạm vi người dùng.\n                        </p>\n                    </div>\n                    <div class=\"rounded-xl border border-[#d4dce4] bg-[#eef4f9] p-4\" data-kid=\"1-1-5-1-2-4\">\n                        <div class=\"text-[9px] font-bold text-[#3772a9]\" data-kid=\"1-1-5-1-2-4-1\">\n                            04\n                        </div>\n                        <div class=\"mt-2 text-[11px] font-bold text-[#203958]\" data-kid=\"1-1-5-1-2-4-2\">\n                            Đối chiếu\n                        </div>\n                        <p class=\"mt-1 text-[9px] leading-4 text-[#66798f]\" data-kid=\"1-1-5-1-2-4-3\">\n                            Mở đoạn, kiểm tra hiệu lực và đánh dấu rà soát.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"mt-4 flex flex-wrap items-center gap-2 rounded-lg border border-[#e2d6c2] bg-[#f7f1e5] px-3 py-2.5 text-[9px] leading-4 text-[#715c3e]\" data-kid=\"1-1-5-1-3\">\n                    <i class=\"ti ti-info-circle text-sm\" data-kid=\"1-1-5-1-3-1\">\n                    </i>\n                    <span data-kid=\"1-1-5-1-3-2\">\n                        <b data-kid=\"1-1-5-1-3-2-1\">\n                            Nhánh kiểm soát:\n                        </b>\n                        OCR / metadata chưa đạt → Chờ duyệt; chưa xác minh → không trình bày như nguồn đã kiểm chứng.\n                    </span>\n                </div>\n            </section>\n            <section class=\"rounded-2xl border border-[#ccd4dd] bg-white p-6 shadow-[0_14px_42px_-34px_rgba(15,30,54,.38)]\" data-kid=\"1-1-5-2\">\n                <div class=\"text-[9px] font-bold uppercase tracking-[.17em] text-[#8a785d]\" data-kid=\"1-1-5-2-1\">\n                    MINH BẠCH DỮ LIỆU\n                </div>\n                <h3 class=\"font-editorial mt-1 text-3xl font-semibold text-[#172e4f]\" data-kid=\"1-1-5-2-2\">\n                    Biết rõ phạm vi trước khi tra cứu\n                </h3>\n                <p class=\"mt-2 text-[10px] leading-5 text-[#647388]\" data-kid=\"1-1-5-2-3\">\n                    Chỉ hiển thị số liệu từ nguồn thống kê công khai thực tế. Mẫu bên dưới không đại diện cho kho đã đồng bộ.\n          