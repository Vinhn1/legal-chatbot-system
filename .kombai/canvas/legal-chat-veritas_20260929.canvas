h-1.5 w-[44%] rounded-full bg-[#b18b53]\" data-kid=\"1-1-13-2-2-4-3-1\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"mt-3 flex justify-end\" data-kid=\"1-1-13-2-2-5\">\n                        <button class=\"rounded-md bg-[#214f7d] px-3 py-2 text-[8px] font-bold text-white\" data-kid=\"1-1-13-2-2-5-1\">\n                            Lưu bản nháp\n                        </button>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <section class=\"screen mb-6 overflow-hidden rounded-2xl border border-[#d1d8de] bg-white\" data-kid=\"1-1-14\">\n            <div class=\"flex items-center justify-between border-b border-[#e4e6e8] px-5 py-2.5\" data-kid=\"1-1-14-1\">\n                <span class=\"fine text-[9px] font-bold uppercase text-[#778599]\" data-kid=\"1-1-14-1-1\">\n                    Màn hình · Thử chatbot · Trích dẫn đang mở\n                </span>\n                <span class=\"rounded-full bg-[#f7f0e3] px-2 py-1 text-[8px] font-bold text-[#80643e]\" data-kid=\"1-1-14-1-2\">\n                    Dữ liệu minh họa\n                </span>\n            </div>\n            <div class=\"grid min-h-[420px] lg:grid-cols-[190px_1fr_285px]\" data-kid=\"1-1-14-2\">\n                <aside class=\"hidden border-r border-[#e7e8e6] bg-[#faf9f6] p-3 lg:block\" data-kid=\"1-1-14-2-1\">\n                    <b class=\"text-[9px]\" data-kid=\"1-1-14-2-1-1\">\n                        Phiên thử nghiệm\n                    </b>\n                    <button class=\"mt-3 w-full rounded-md bg-[#eaf0f5] px-2 py-2 text-left text-[8px] font-semibold text-[#355b7d]\" data-kid=\"1-1-14-2-1-2\">\n                        + Câu hỏi mới\n                    </button>\n                    <div class=\"mt-4 rounded-md border border-[#e5e0d5] bg-white p-2 text-[8px] text-[#69798c]\" data-kid=\"1-1-14-2-1-3\">\n                        Lịch sử gần đây\n                        <br data-kid=\"1-1-14-2-1-3-1\"/>\n                        <span class=\"mt-1 block text-[7px] text-[#909aa5]\" data-kid=\"1-1-14-2-1-3-2\">\n                            Dữ liệu minh họa\n                        </span>\n                    </div>\n                </aside>\n                <div class=\"flex min-w-0 flex-col\" data-kid=\"1-1-14-2-2\">\n                    <div class=\"flex items-center justify-between border-b border-[#e7e8e6] px-4 py-3\" data-kid=\"1-1-14-2-2-1\">\n                        <div data-kid=\"1-1-14-2-2-1-1\">\n                            <b class=\"text-[10px]\" data-kid=\"1-1-14-2-2-1-1-1\">\n                                Thử chatbot\n                            </b>\n                            <span class=\"ml-2 text-[8px] text-[#8b96a1]\" data-kid=\"1-1-14-2-2-1-1-2\">\n                                Kho được phép truy cập\n                            </span>\n                        </div>\n                        <span class=\"rounded-full border border-[#dfe4e6] px-2 py-1 text-[7px] text-[#708096]\" data-kid=\"1-1-14-2-2-1-2\">\n                            Tìm nguồn\n                        </span>\n                    </div>\n                    <div class=\"flex-1 space-y-4 bg-[#fafaf8] p-4\" data-kid=\"1-1-14-2-2-2\">\n                        <div class=\"ml-auto max-w-[80%] rounded-xl bg-[#1a3659] px-3 py-2.5 text-[9px] leading-4 text-white\" data-kid=\"1-1-14-2-2-2-1\" data-name=\"user query chat bubble\">\n                            Tôi muốn kiểm tra một quy định trong kho tài liệu.\n                        </div>\n                        <div class=\"max-w-[90%] rounded-xl border border-[#e1e5e5] bg-white p-3\" data-kid=\"1-1-14-2-2-2-2\" data-name=\"bot response chat bubble\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-14-2-2-2-2-1\">\n                                <span class=\"grid h-6 w-6 place-items-center rounded-md bg-[#172e4e] text-white\" data-kid=\"1-1-14-2-2-2-2-1-1\">\n                                    <i class=\"ti ti-scale text-xs\" data-kid=\"1-1-14-2-2-2-2-1-1-1\">\n                                    </i>\n                                </span>\n                                <b class=\"text-[8px]\" data-kid=\"1-1-14-2-2-2-2-1-2\">\n                                    Trả lời · Dữ liệu minh họa\n                                </b>\n                            </div>\n                            <p class=\"mt-2 text-[9px] leading-5 text-[#536175]\" data-kid=\"1-1-14-2-2-2-2-2\">\n                                Bản trình diễn giữ từng nhận định cạnh nguồn tương ứng. Khi không có đủ căn cứ, hệ thống phải nói rõ thay vì suy đoán.\n                            </p>\n                            <p class=\"mt-2 text-[9px] leading-5 text-[#536175]\" data-kid=\"1-1-14-2-2-2-2-3\">\n                                Đoạn dưới đây chỉ minh họa vị trí hiển thị nội dung trả về, không phải trích dẫn pháp luật thật.\n                            </p>\n                            <button class=\"mt-2 rounded-md border border-[#a7bfd4] bg-[#edf4f9] px-2.5 py-1.5 text-[8px] font-bold text-[#31587d] focus-ring\" data-kid=\"1-1-14-2-2-2-2-4\" data-name=\"sample source button\">\n                                Nguồn mẫu · đoạn được chọn\n                                <i class=\"ti ti-arrow-up-right ml-1\" data-kid=\"1-1-14-2-2-2-2-4-1\">\n                                </i>\n                            </button>\n                            <p class=\"mt-2 text-[7px] text-[#818d9a]\" data-kid=\"1-1-14-2-2-2-2-5\">\n                                Chưa xác minh hiệu lực · Mở đoạn nguồn để tự đối chiếu\n                            </p>\n                        </div>\n                        <div class=\"rounded-lg border border-[#e7dcc8] bg-[#faf5eb] p-3 text-[8px] leading-4 text-[#766342]\" data-kid=\"1-1-14-2-2-2-3\" data-name=\"insufficient data alert\">\n                            <b data-kid=\"1-1-14-2-2-2-3-1\">\n                                Chưa đủ căn cứ trong kho tài liệu hiện có.\n                            </b>\n                            <br data-kid=\"1-1-14-2-2-2-3-2\"/>\n                            Hãy thử thu hẹp câu hỏi hoặc kiểm tra phạm vi văn bản đã được lập chỉ mục.\n                        </div>\n                    </div>\n                    <div class=\"border-t border-[#e5e7e7] bg-white p-3\" data-kid=\"1-1-14-2-2-3\">\n                        <div class=\"rounded-lg border border-[#d7dee3] p-2\" data-kid=\"1-1-14-2-2-3-1\" data-name=\"chat input field\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-14-2-2-3-1-1\">\n                                <span class=\"text-[8px] text-[#98a1aa]\" data-kid=\"1-1-14-2-2-3-1-1-1\">\n                                    Nhập câu hỏi pháp luật…\n                                </span>\n                                <span class=\"ml-auto rounded-md bg-[#214f7d] px-3 py-1.5 text-[8px] font-bold text-white\" data-kid=\"1-1-14-2-2-3-1-1-2\">\n                                    Gửi\n                                </span>\n                            </div>\n                        </div>\n                        <div class=\"mt-1.5 flex justify-between text-[7px] text-[#8b96a0]\" data-kid=\"1-1-14-2-2-3-2\">\n                            <span data-kid=\"1-1-14-2-2-3-2-1\">\n                                Enter để gửi · Shift + Enter xuống dòng\n                            </span>\n                            <span data-kid=\"1-1-14-2-2-3-2-2\">\n                                0 / 2000\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <aside class=\"border-l border-[#e7e3d9] bg-[#faf8f2] p-4\" data-kid=\"1-1-14-2-3\">\n                    <div class=\"flex justify-between\" data-kid=\"1-1-14-2-3-1\">\n                        <div data-kid=\"1-1-14-2-3-1-1\">\n                            <sp