1-20-1-3-2-1\">\n                            <div class=\"rounded border bg-[#faf9f6] p-2 text-[6px] text-[#64768b]\" data-kid=\"1-1-20-1-3-2-1-1\">\n                                Nhận định gắn với\n                                <span class=\"text-[#315c82]\" data-kid=\"1-1-20-1-3-2-1-1-1\">\n                                    nguồn mẫu\n                                </span>\n                                .\n                            </div>\n                        </div>\n                        <div class=\"border-l bg-[#faf8f2] p-3 text-[6px] text-[#68788a]\" data-kid=\"1-1-20-1-3-2-2\">\n                            ĐOẠN NGUỒN\n                            <div class=\"mt-2 rounded bg-[#fff0d3] p-2\" data-kid=\"1-1-20-1-3-2-2-1\">\n                                Đoạn được chọn\n                            </div>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"overflow-hidden rounded-xl border border-[#263954] bg-[#101d30] text-[#d9e2ec]\" data-kid=\"1-1-20-1-4\">\n                    <div class=\"fine border-b border-[#293951] px-4 py-2 text-[7px] font-bold uppercase text-[#afbdce]\" data-kid=\"1-1-20-1-4-1\">\n                        Chat · dark\n                    </div>\n                    <div class=\"grid min-h-[130px] grid-cols-[1fr_135px]\" data-kid=\"1-1-20-1-4-2\">\n                        <div class=\"p-3\" data-kid=\"1-1-20-1-4-2-1\">\n                            <div class=\"rounded border border-[#34445b] bg-[#1b2b41] p-2 text-[6px]\" data-kid=\"1-1-20-1-4-2-1-1\">\n                                Nhận định gắn với\n                                <span class=\"text-[#b4cbe0]\" data-kid=\"1-1-20-1-4-2-1-1-1\">\n                                    nguồn mẫu\n                                </span>\n                                .\n                            </div>\n                        </div>\n                        <div class=\"border-l border-[#293951] bg-[#1b2a40] p-3 text-[6px] text-[#cfdae6]\" data-kid=\"1-1-20-1-4-2-2\">\n                            ĐOẠN NGUỒN\n                            <div class=\"mt-2 rounded bg-[#4a402d] p-2\" data-kid=\"1-1-20-1-4-2-2-1\">\n                                Đoạn được chọn\n                            </div>\n                        </div>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mt-4 grid gap-4 lg:grid-cols-[1fr_1fr]\" data-kid=\"1-1-20-2\">\n                <article class=\"rounded-xl border border-[#e0e3e3] bg-white p-4\" data-kid=\"1-1-20-2-1\">\n                    <span class=\"fine text-[8px] font-bold uppercase text-[#79889a]\" data-kid=\"1-1-20-2-1-1\">\n                        Palette · Light / Dark\n                    </span>\n                    <div class=\"mt-3 grid grid-cols-2 gap-4\" data-kid=\"1-1-20-2-1-2\">\n                        <div data-kid=\"1-1-20-2-1-2-1\">\n                            <b class=\"text-[7px] text-[#68788b]\" data-kid=\"1-1-20-2-1-2-1-1\">\n                                LIGHT\n                            </b>\n                            <div class=\"mt-1.5 flex gap-1\" data-kid=\"1-1-20-2-1-2-1-2\">\n                                <i class=\"h-7 flex-1 rounded border bg-[#fbfaf7]\" data-kid=\"1-1-20-2-1-2-1-2-1\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#172d4b]\" data-kid=\"1-1-20-2-1-2-1-2-2\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#285781]\" data-kid=\"1-1-20-2-1-2-1-2-3\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#bd975e]\" data-kid=\"1-1-20-2-1-2-1-2-4\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#50775f]\" data-kid=\"1-1-20-2-1-2-1-2-5\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#a9614e]\" data-kid=\"1-1-20-2-1-2-1-2-6\">\n                                </i>\n                            </div>\n                            <p class=\"mt-1 text-[6px] text-[#8a949f]\" data-kid=\"1-1-20-2-1-2-1-3\">\n                                Paper · Ink · Action · Amber · Active · Review\n                            </p>\n                        </div>\n                        <div data-kid=\"1-1-20-2-1-2-2\">\n                            <b class=\"text-[7px] text-[#aebaca]\" data-kid=\"1-1-20-2-1-2-2-1\">\n                                DARK\n                            </b>\n                            <div class=\"mt-1.5 flex gap-1\" data-kid=\"1-1-20-2-1-2-2-2\">\n                                <i class=\"h-7 flex-1 rounded bg-[#101d30]\" data-kid=\"1-1-20-2-1-2-2-2-1\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#1b2a40]\" data-kid=\"1-1-20-2-1-2-2-2-2\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#456d94]\" data-kid=\"1-1-20-2-1-2-2-2-3\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#ad874f]\" data-kid=\"1-1-20-2-1-2-2-2-4\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#4e8169]\" data-kid=\"1-1-20-2-1-2-2-2-5\">\n                                </i>\n                                <i class=\"h-7 flex-1 rounded bg-[#a45f4d]\" data-kid=\"1-1-20-2-1-2-2-2-6\">\n                                </i>\n                            </div>\n                            <p class=\"mt-1 text-[6px] text-[#8a949f]\" data-kid=\"1-1-20-2-1-2-2-3\">\n                                Navy · Surface · Action · Amber · Active · Review\n                            </p>\n                        </div>\n                    </div>\n                </article>\n                <article class=\"rounded-xl border border-[#e0e3e3] bg-white p-4\" data-kid=\"1-1-20-2-2\">\n                    <span class=\"fine text-[8px] font-bold uppercase text-[#79889a]\" data-kid=\"1-1-20-2-2-1\">\n                        Type · spacing · motion\n                    </span>\n                    <div class=\"mt-2 flex items-end justify-between border-b border-[#e6e8e7] pb-3\" data-kid=\"1-1-20-2-2-2\">\n                        <div data-kid=\"1-1-20-2-2-2-1\">\n                            <div class=\"ed text-3xl font-semibold text-[#172e4e]\" data-kid=\"1-1-20-2-2-2-1-1\">\n                                Văn bản là chứng cứ.\n                            </div>\n                            <div class=\"text-[7px] text-[#84909e]\" data-kid=\"1-1-20-2-2-2-1-2\">\n                                Newsreader · tiêu đề biên tập\n                            </div>\n                        </div>\n                        <span class=\"text-right text-[7px] text-[#62758b]\" data-kid=\"1-1-20-2-2-2-2\">\n                            DM Sans\n                            <br data-kid=\"1-1-20-2-2-2-2-1\"/>\n                            UI & nội dung\n                            <br data-kid=\"1-1-20-2-2-2-2-2\"/>\n                            12–16 px\n                        </span>\n                    </div>\n                    <div class=\"mt-3 text-[7px] text-[#758398]\" data-kid=\"1-1-20-2-2-3\">\n                        Spacing 4 · 8 · 12 · 16 · 24 · 32 · 48\n                    </div>\n                    <div class=\"mt-2 rounded border border-[#dce2e6] bg-[#f8f9f8] p-2 text-[7px] text-[#738196]\" data-kid=\"1-1-20-2-2-4\">\n                        <span class=\"rounded-sm outline outline-2 outline-offset-2 outline-[#3b79a7]\" data-kid=\"1-1-20-2-2-4-1\">\n                            Focus-visible\n                        </span>\n                        <span class=\"ml-4\" data-kid=\"1-1-20-2-2-4-2\">\n                            Nút/tab 160 ms · drawer 200 ms ease-out\n                        </span>\n                        <p class=\"mt-2\" data-kid=\"1-1-20-2-2-4-3\">\n                            prefers-reduced-motion → bỏ dịch chuyển, mở/đóng tức thì.\n                        </p>\n                    </div>\n                </article>\n            </div>\n            <div class=\"mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4\" data-kid=\"1-1-20-3\">\n                <article class=\"rounded-lg border border-[#e0e3e3] bg-white p-3\" data-kid=\"1-1-20-3-1\">\n                    <span class=\"fine text-[7px] font-bold uppercase text-[#84909c]\" data-kid=\"1-1-20-3-1-1\">\n                        Button · Input\n                    </span>\n                    <div class=\"mt-2 flex gap-2\" data-kid=\"1-1-20-3-1-2\">\n                        <button class=\"rounded bg-[#214f7d] px-3 py-2 text-[7px] font-bold text-white\" data-kid=\"1-1-20-3-1-2-1\">\n                            Primary action\n                        </button>\n                        <button class=\"rounded border border-[#d5dce0] px-3 py-2 text-[7px]\" data-kid=\"1-1-20-3-1-2-2\">\n                            Secondary\n                        </button>\n                    </div>\n                    <div class=\"focus-ring mt-2 rounded border border-[#9db7cb] bg-white px-2 py-2 text-[7px] text-[#909aa4]\" data-kid=\"1-1-20-3-1-3\">\n                        Focus rõ · nhãn không biến mất\n                    </div>\n                </article>\n                <article class=\"rounded-lg border border-[#e0e3e3] bg-white p-3\" data-kid=\"1-1-20-3-2\">\n                    <span class=\"fine text-[7px] font-bold uppercase text-[#84909c]\" data-kid=\"1-1-20-3-2-1\">\n                        Trạng thái · hiệu lực ≠ pipeline\n                    </span>\n                    <div class=\"mt-2 flex flex-wrap gap-1\" data-kid=\"1-1-20-3-2-2\">\n                        <span class=\"rounded-full bg-[#edf4ee] px-2 py-1 text-[6px] text-[#4e7459]\" data-kid=\"1-1-20-3-2-2-1\" data-name=\"valid status tag\">\n                            Còn hiệu lực*\n                        </span>\n                        <span class=\"rounded-full bg-[#f8f0df] px-2 py-1 text-[6px] text-[#856942]\" data-kid=\"1-1-20-3-2-2-2\" data-name=\"unverified status tag\">\n                            Chưa xác minh\n                        </span>\n                    </div>\n                    <div class=\"mt-1 flex flex-wrap gap-1\" data-kid=\"1-1-20-3-2-3\">\n                        <span class=\"rounded-full bg-[#edf2f6] px-2 py-1 text-[6px] text-[#536f88]\" data-kid=\"1-1-20-3-2-3-1\" data-name=\"indexed status tag\">\n                            Đã lập chỉ mục*\n                        </span>\n                        <span class=\"rounded-full bg-[#f8eee8] px-2 py-1 text-[6px] text-[#96644d]\" data-kid=\"1-1-20-3-2-3-2\" data-name=\"pending status tag\">\n                            Chờ duyệt\n                        </span>\n                    </div>\n                    <small class=\"mt-1 block text-[6px] text-[#9099a1]\" data-kid=\"1-1-20-3-2-4\">\n                        * Chỉ là trạng thái dữ liệu minh họa.\n                    </small>\n                </article>\n                <article class=\"rounded-lg border border-[#e0e3e3] bg-white p-3\" data-kid=\"1-1-20-3-3\">\n                    <span class=\"fine text-[7px] font-bold uppercase text-[#84909c]\" data-kid=\"1-1-20-3-3-1\">\n                        Card · Table\n                    </span>\n                    <div class=\"mt-2 rounded border border-[#e4e7e6] bg-[#fbfaf7] p-2 text-[7px]\" data-kid=\"1-1-20-3-3-2\">\n                        <b data-kid=\"1-1-20-3-3-2-1\">\n                            Tài liệu mẫu · bản nhập\n                        </b>\n                        <div class=\"mt-1 text-[6px] text-[#84909d]\" data-kid=\"1-1-20-3-3-2-2\">\n                            Tên/nguồn　Hiệu lực　Pipeline\n                        </div>\n                        <div class=\"mt-1 border-t pt-1 text-[6px]\" data-kid=\"1-1-20-3-3-2-3\">\n                            OCR thấp　　 Chưa xác minh　 Rà soát\n                        </div>\n                    </div>\n                </article>\n                <article class=\"rounded-lg border border-[#e0e3e3] bg-white p-3\" data-kid=\"1-1-20-3-4\">\n                    <span class=\"fine text-[7px] font-bold uppercase text-[#84909c]\" data-kid=\"1-1-20-3-4-1\">\n                        Sidebar · Citation panel\n                    </span>\n                    <div class=\"mt-2 flex gap-2\" data-kid=\"1-1-20-3-4-2\">\n                        <div class=\"w-[90px] rounded bg-[#172e4e] p-2 text-[6px] text-white\" data-kid=\"1-1-20-3-4-2-1\">\n                            Veritas Legal\n                            <div class=\"mt-2 rounded bg-[#2b4c70] p-1\" data-kid=\"1-1-20-3-4-2-1-1\">\n                                ▦ Tổng quan\n                            </div>\n                            <div class=\"mt-1 p-1 text-[#c5d2df]\" data-kid=\"1-1-20-3-4-2-1-2\">\n                                ▤ Tài liệu\n                            </div>\n                        </div>\n                        <div class=\"flex-1 rounded border border-[#e7e0d4] bg-[#faf8f2] p-2 text-[6px] text-[#7c6746]\" data-kid=\"1-1-20-3-4-2-2\">\n                            ĐOẠN NGUỒN\n                            <div class=\"mt-1 rounded bg-[#fff0d3] p-2 text-[#68788c]\" data-kid=\"1-1-20-3-4-2-2-1\">\n                                Right drawer desktop\n                                <br data-kid=\"1-1-20-3-4-2-2-1-1\"/>\n                                Bottom sheet mobile\n                            </div>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </section>\n        <section class=\"mb-6 rounded-xl border border-[#253b56] bg-[#172d4b] p-5 text-white md:p-6\" data-kid=\"1-1-21\">\n            <div class=\"grid gap-4 md:grid-cols-[.7fr_1.3fr]\" data-kid=\"1-1-21-1\">\n                <div data-kid=\"1-1-21-1-1\">\n                    <span class=\"fine text-[8px] font-bold uppercase text-[#d6bb88]\" data-kid=\"1-1-21-1-1-1\">\n                        Lý do chọn bố cục & chuyển động\n                    </span>\n                    <h2 class=\"ed mt-2 text-3xl font-semibold\" data-kid=\"1-1-21-1-1-2\">\n                        Giữ chứng cứ trong tầm nhìn.\n                    </h2>\n                </div>\n                <div class=\"grid gap-3 sm:grid-cols-2\" data-kid=\"1-1-21-1-2\">\n                    <p class=\"text-[9px] leading-5 text-[#c2cedb]\" data-kid=\"1-1-21-1-2-1\">\n                        Khi nhận định và đoạn nguồn cùng hiện diện, người đọc không phải tự nối chúng từ một danh sách trích dẫn cuối câu trả lời. Cùng một cách trình bày theo suốt landing, chatbot và rà soát hội thoại tạo dấu ấn pháp lý thay vì thay logo lên một dashboard chung.\n                    </p>\n                    <p class=\"text-[9px] leading-5 text-[#c2cedb]\" data-kid=\"1-1-21-1-2-2\">\n                        Chuyển động định hướng: 160 ms cho hover/nút/tab; 200 ms ease-out cho drawer và panel. Focus dễ thấy; Escape đóng và trả focus. prefers-reduced-motion bỏ dịch chuyển để trạng thái đổi tức thì; không dùng typing hoặc parallax.\n                    </p>\n                </div>\n            </div>\n            <p class=\"mt-3 border-t border-white/15 pt-3 text-[7px] leading-4 text-[#91a2b6]\" data-kid=\"1-1-21-2\" data-name=\"disclaimer text\">\n                Các trang quản trị trên đây là mockup đề xuất; không khẳng định route/API đã có. Tất cả số và nội dung mẫu đều là dữ liệu minh họa, không xác minh hiệu lực và không phải tư vấn pháp lý.\n            </p>\n        </section>\n        <footer class=\"pb-10 text-center text-[8px] uppercase tracking-[.14em] text-[#8793a0]\" data-kid=\"1-1-22\">\n            Veritas Editorial · Citation first · UI design proposal\n        </footer>\n    </main>\n</div>\n",
