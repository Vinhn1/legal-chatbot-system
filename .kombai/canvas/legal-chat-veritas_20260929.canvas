      "viewportScrollY": 739
    },
    "var_8357b4e06ee6": {
      "type": "variant",
      "label": "04 · Veritas — Đối chiếu trước",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 7700,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.35.0/dist/tabler-icons.min.css');\n.ui{font-family:'DM Sans',sans-serif}.ed{font-family:'Newsreader',serif}.fine{letter-spacing:.16em}.paper{background:#fbfaf7}.ink{color:#152b49}.muted{color:#66758a}.screen{box-shadow:0 18px 48px -32px rgba(17,35,59,.34)}.focus-ring{outline:2px solid #3a79a8;outline-offset:3px}\n</style>\n<div class=\"ui min-h-screen bg-[#e9edf2] text-[#182b45] antialiased\" data-kid=\"1\">\n    <main class=\"mx-auto max-w-[1360px] px-5 py-8 md:px-9 lg:px-12\" data-kid=\"1-1\">\n        <header class=\"mb-7 flex flex-col gap-5 border-b border-[#ccd5df] pb-6 md:flex-row md:items-end md:justify-between\" data-kid=\"1-1-1\">\n            <div data-kid=\"1-1-1-1\">\n                <div class=\"fine flex items-center gap-2 text-[10px] font-bold uppercase text-[#718096]\" data-kid=\"1-1-1-1-1\">\n                    <span class=\"h-px w-8 bg-[#bb9259]\" data-kid=\"1-1-1-1-1-1\">\n                    </span>\n                    Veritas Legal Design · System concept 01\n                </div>\n                <h1 class=\"ed mt-2 text-4xl font-semibold leading-none tracking-[-.035em] text-[#142847] md:text-5xl\" data-kid=\"1-1-1-1-2\" data-name=\"hero section main headline\">\n                    Mỗi nhận định, một đường về nguồn.\n                </h1>\n                <p class=\"muted mt-3 max-w-3xl text-sm leading-6\" data-kid=\"1-1-1-1-3\">\n                    Hệ thống giao diện cho tra cứu pháp luật Việt Nam bằng RAG — thiết kế quanh khả năng đọc, kiểm tra và xử lý tiếp.\n                </p>\n            </div>\n            <div class=\"flex flex-wrap gap-2 text-[10px] font-semibold\" data-kid=\"1-1-1-2\">\n                <span class=\"rounded-full border border-[#dfd0b6] bg-[#faf5e9] px-3 py-1.5 text-[#7e633c]\" data-kid=\"1-1-1-2-1\">\n                    Đề xuất giao diện · Dữ liệu minh họa\n                </span>\n                <span class=\"rounded-full border border-[#ccd5df] bg-white px-3 py-1.5 text-[#56677d]\" data-kid=\"1-1-1-2-2\">\n                    1440 · 768 · 390\n                </span>\n                <span class=\"rounded-full border border-[#ccd5df] bg-white px-3 py-1.5 text-[#56677d]\" data-kid=\"1-1-1-2-3\">\n                    Light + dark\n                </span>\n            </div>\n        </header>\n        <section class=\"mb-8 rounded-2xl border border-[#d2d9e0] bg-[#fbfaf7] p-5 md:p-6\" data-kid=\"1-1-2\">\n            <div class=\"fine mb-4 text-[10px] font-bold uppercase text-[#778599]\" data-kid=\"1-1-2-1\">\n                Hai hướng art direction · Hướng được chọn\n            </div>\n            <div class=\"grid gap-3 lg:grid-cols-[1fr_1fr_1.15fr]\" data-kid=\"1-1-2-2\">\n                <article class=\"rounded-xl border border-[#e3e4e1] bg-white p-4\" data-kid=\"1-1-2-2-1\">\n                    <div class=\"fine text-[9px] font-bold uppercase text-[#8a96a3]\" data-kid=\"1-1-2-2-1-1\">\n                        01 · Veritas Editorial\n                    </div>\n                    <h2 class=\"ed mt-1 text-xl font-semibold\" data-kid=\"1-1-2-2-1-2\">\n                        Văn bản là giao diện\n                    </h2>\n                    <p class=\"mt-1 text-xs leading-5 text-[#6a788b]\" data-kid=\"1-1-2-2-1-3\">\n                        Nhịp đọc biên tập, khoảng trắng và trích dẫn làm trọng tâm.\n                        <b data-kid=\"1-1-2-2-1-3-1\">\n                            Điểm mạnh:\n                        </b>\n                        đáng tin, dễ đọc từ landing tới công cụ tra cứu.\n                    </p>\n                </article>\n                <article class=\"rounded-xl border border-[#e3e4e1] bg-white p-4\" data-kid=\"1-1-2-2-2\">\n                    <div class=\"fine text-[9px] font-bold uppercase text-[#8a96a3]\" data-kid=\"1-1-2-2-2-1\">\n                        02 · Evidence Workbench\n                    </div>\n                    <h2 class=\"ed mt-1 text-xl font-semibold\" data-kid=\"1-1-2-2-2-2\">\n                        Ngoại lệ cần xử lý\n                    </h2>\n                    <p class=\"mt-1 text-xs leading-5 text-[#6a788b]\" data-kid=\"1-1-2-2-2-3\">\n                        Bảng vận hành và trạng thái nằm trước.\n                        <b data-kid=\"1-1-2-2-2-3-1\">\n                            Điểm mạnh:\n                        </b>\n                        phát hiện nhanh OCR, metadata, hiệu lực.\n                    </p>\n                </article>\n                <article class=\"rounded-xl border border-[#183352] bg-[#162c4b] p-4 text-white\" data-kid=\"1-1-2-2-3\">\n                    <div class=\"fine text-[9px] font-bold uppercase text-[#d6c195]\" data-kid=\"1-1-2-2-3-1\">\n                        Được chọn · Citation-first\n                    </div>\n                    <h2 class=\"ed mt-1 text-xl font-semibold\" data-kid=\"1-1-2-2-3-2\">\n                        Nhận định → trích dẫn → đoạn gốc\n                    </h2>\n                    <p class=\"mt-1 text-xs leading-5 text-[#d5deea]\" data-kid=\"1-1-2-2-3-3\">\n                        Một đường đối chiếu xuyên suốt, bổ sung hàng đợi ngoại lệ trong admin mà không biến mọi màn thành dashboard mẫu.\n                    </p>\n                </article>\n            </div>\n            <p class=\"mt-3 text-[10px] text-[#788697]\" data-kid=\"1-1-2-3\">\n                Tham chiếu phân tích: Harvey, HeinOnline, shadcn/ui Blocks, Studio Admin — chỉ học cách tổ chức thông tin, không sao chép giao diện hay thương hiệu.\n                <b class=\"text-[#8b693e]\" data-kid=\"1-1-2-3-1\" data-name=\"placeholder image reference text\">\n                    t06-summary-1280.png: ảnh tham chiếu chưa khả dụng.\n                </b>\n            </p>\n        </section>\n        <div cla